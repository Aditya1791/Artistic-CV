# Database Connection URL (SQLite default, PostgreSQL/MySQL supported)
# Examples:
# SQLite: sqlite:///./artcv.db
# PostgreSQL: postgresql://username:password@localhost:5432/artcvdb
DATABASE_URL=sqlite:///./artcv.db

# JWT Secret Key for Session Authentication (Change to random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-me

# OAuth Credentials (Optional - for Google & Facebook Login)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
FACEBOOK_APP_ID=your-facebook-app-id

# Server Port & Host Configuration
PORT=8000
HOST=0.0.0.0
